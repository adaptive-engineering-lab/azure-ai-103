# Copy to .env.local. Only public (anon) keys belong here.
# The service_role key is for the seed tooling only (tools/.env.local), NEVER the frontend.

# AI-103 Supabase project — get these from your Supabase dashboard.
# New-style keys (sb_publishable_…) work here too: supabase-js passes the key
# straight through as a header and never decodes it.
VITE_SUPABASE_URL=https://bybzxeiittjhyeattcrt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Exam identity. Resolved by src/lib/branding.ts and used everywhere the exam
# is named: page title and meta description, the PWA manifest, the home hero,
# install prompt, countdown widget, Pro page, and both legal pages.
#
# All three are OPTIONAL. Unset or blank falls back to the AI-103 defaults
# committed in branding.ts, so a missing variable renders correct branding
# rather than a blank title. Override them to re-skin for another exam without
# touching source.
#
# Read at BUILD time, so change them and rebuild — a running dev server picks
# up .env.local edits on restart, and Vercel needs a redeploy.
VITE_EXAM_CODE=AI-103
VITE_EXAM_TITLE=Developing AI Apps and Agents on Azure
VITE_CERT_TITLE=Azure AI Apps and Agents Developer Associate

# Product-ID mode was specified but never built (AI103-Game-Spec.md §6.4), and
# nothing reads this. Left as a marker of the decision; safe to delete.
VITE_ENABLE_PRODUCT_ID=false
