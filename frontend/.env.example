# Copy to .env.local. Only public (anon) keys belong here.
# The service_role key is for the seed tooling only (tools/.env.local), NEVER the frontend.

# AI-103 Supabase project — get these from your Supabase dashboard.
# New-style keys (sb_publishable_…) work here too: supabase-js passes the key
# straight through as a header and never decodes it.
VITE_SUPABASE_URL=https://bybzxeiittjhyeattcrt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Exam identity. NOTE: nothing in frontend/src reads these — the title and
# meta tags are literals in index.html and the PWA manifest in vite.config.ts.
# Inherited from the AZ-104 ancestor; kept only so the intent stays visible.
VITE_EXAM_CODE=AI-103
VITE_EXAM_TITLE=Developing AI Apps and Agents on Azure
VITE_CERT_TITLE=Azure AI Apps and Agents Developer Associate

# Product-ID mode was specified but never built (AI103-Game-Spec.md §6.4).
# Also unread by any source file.
VITE_ENABLE_PRODUCT_ID=false
